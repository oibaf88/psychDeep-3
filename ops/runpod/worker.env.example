# Runpod vLLM worker configuration TEMPLATE. Not a .env file to commit with secrets.
# USER MODEL REQUIREMENT: Biomedical Llama 3.1 (exact Hugging Face repo not yet verified).
# Do not substitute a similarly named MedQA model or a Llama 3.0 checkpoint.
# Set the model only after verifying its actual Hugging Face repository, model card,
# base lineage (Llama 3.1), license, revision, and vLLM compatibility.
# Set in the Runpod endpoint UI; verify support in the exact deployed worker version.
# Review medical safety and EU/EEA data handling BEFORE clinical traffic.
MODEL_NAME=REPLACE_WITH_VERIFIED_BIOMEDICAL_LLAMA_3_1_REPOSITORY
# Replace this REQUIRED placeholder with the reviewed exact Hugging Face commit SHA.
MODEL_REVISION=REPLACE_WITH_VERIFIED_MODEL_COMMIT
DTYPE=bfloat16
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=2
# For private/gated models add HF_TOKEN as a Runpod secret, never to this file.
# Do not use a served-model-name override unless you update all Render model IDs
# to match the exact /models result.
# Provision GPU >=24GB as initial sizing estimate ONLY for an 8B BF16 model;
# re-evaluate VRAM sizing for the actual confirmed checkpoint.
# Set min workers 0 and max workers 1 for a prototype (GPU and storage not free).
