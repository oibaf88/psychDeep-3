# PsychDeep local/offline profile. Copy to .env.local; never commit .env.local.

# Local database password. Change this before first startup if the laptop may
# be shared. The database is bound to 127.0.0.1 only.
LOCAL_DB_PASSWORD=CHANGE_ME_LOCAL_DB
DATABASE_SCHEMA=psychdeep_v12

# Auth for the local PsychDeep instance. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_WITH_64_RANDOM_HEX_CHARS
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=false
ALLOW_MOCK_GOOGLE_LOGIN=false

# The product default is Claude/Anthropic. This local/offline profile
# deliberately overrides it to Gemma 2 so the laptop remains autonomous when
# it has no Internet connection. The backend is a Docker container, hence
# host.docker.internal.
# The model string MUST exactly match one item returned by LM Studio /v1/models.
LLM_DEFAULT_PROVIDER=openai_compatible
LLM_OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:1234/v1
LLM_OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_CHAT_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_ANALYSIS_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_COPILOT_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=300
LLM_OPENAI_COMPATIBLE_MAX_TOKENS=8192
LLM_ALLOW_RUNTIME_OVERRIDE=true

# Optional email; leave blank offline.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=psychapp@localhost
