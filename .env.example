# PsychDeep vNext development/deployment example.
# Copy only to a non-tracked environment file. Never commit real credentials.
# Clinical data is cloud-authoritative; this file does NOT configure a local
# clinical PostgreSQL/product stack.

# ---------------------------------------------------------------- Database
# Production: existing Supabase pooler connection string with TLS.
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
DATABASE_SCHEMA=psychdeep_v12

# ---------------------------------------------------------------- Auth
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# ---------------------------------------------------------- Model Gateway
# Deployment default. Admin clinical may explicitly switch between the approved
# local/OpenAI-compatible endpoint and Anthropic when runtime override is on.
# There is no automatic provider fallback.
MODEL_DEPLOYMENT_ALIAS=local-tunnel
MODEL_POLICY_VERSION=support-policy-v1
MODEL_ALLOW_COMMERCIAL=true

# LM Studio is bound to 127.0.0.1:1234 on the operator's PC. Cloudflare Tunnel
# routes https://ai.bfab.io to http://localhost:1234. The cloudflared TUNNEL
# TOKEN/SECRET belongs ONLY in the local cloudflared service, never in PsychDeep.
# Set up a Cloudflare Access self-hosted application for ai.bfab.io with a
# Service Auth policy admitting a dedicated service token for psychdeep-api.
# Store the Access client ID and secret in Render's backend environment, NOT
# in this tracked example, frontend, database or GitHub. Never reuse the tunnel
# connector token as either credential.
MODEL_LOCAL_BASE_URL=https://ai.bfab.io/v1
MODEL_LOCAL_CF_ACCESS_REQUIRED=true
MODEL_LOCAL_CF_ACCESS_HOST=ai.bfab.io
MODEL_LOCAL_CF_ACCESS_CLIENT_ID=
MODEL_LOCAL_CF_ACCESS_CLIENT_SECRET=
# LM Studio API authentication is NOT used in Access mode; leave the legacy
# MODEL_LOCAL_API_KEY unset. If it exists from an older deploy, the Access
# adapter deliberately ignores it and does not send Authorization: Bearer.
MODEL_LOCAL_CHAT_MODEL=gemma-2-2b-it
MODEL_LOCAL_ANALYSIS_MODEL=gemma-2-2b-it
MODEL_LOCAL_COPILOT_MODEL=gemma-2-2b-it
MODEL_LOCAL_TIMEOUT_SECONDS=45
MODEL_LOCAL_MAX_TOKENS=8192

# Optional approved cloud-tuned deployment.
MODEL_CLOUD_BASE_URL=
MODEL_CLOUD_API_KEY=
MODEL_CLOUD_CHAT_MODEL=
MODEL_CLOUD_ANALYSIS_MODEL=
MODEL_CLOUD_COPILOT_MODEL=
MODEL_CLOUD_TIMEOUT_SECONDS=45
MODEL_CLOUD_MAX_TOKENS=8192

# Approved commercial provider. The API key is a server-side secret and is
# never returned to the browser or stored in the runtime selection row.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
ANTHROPIC_COPILOT_MODEL=
ANTHROPIC_MAX_TOKENS=8192

# Compatibility names retained for older deployments/adapters. Runtime model
# selection is audited and restricted to admin_clinical.
LLM_DEFAULT_PROVIDER=anthropic
LLM_OPENAI_COMPATIBLE_BASE_URL=https://ai.bfab.io/v1
# Legacy LLM_OPENAI_COMPATIBLE_API_KEY intentionally omitted: the Access
# gateway authenticates this tunnel, and the local LM Studio server requires
# no separate API key in this specific mode.
LLM_OPENAI_COMPATIBLE_CHAT_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_ANALYSIS_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_COPILOT_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=45
LLM_OPENAI_COMPATIBLE_MAX_TOKENS=8192
LLM_ALLOW_RUNTIME_OVERRIDE=true

# ---------------------------------------------------------------- App
APP_LOCALE=es-ES
APP_ENV=production
CORS_ORIGINS=https://psychdeep-web.onrender.com,https://psychdeep.bfab.io
ALLOW_MOCK_GOOGLE_LOGIN=false
SEED_DEMO_DATA=false

# ----------------------------------------------------------- Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=psychapp@bfab.io
