# PsychDeep 3 deployment/default settings. Copy to a non-tracked .env only
# for local development. The PDF local stack instead uses .env.local.

# Claude is the connected-service default. Its API key is server-only.
# Gemma 2 through LM Studio is the optional local/offline alternative.
# Docker local: http://host.docker.internal:1234/v1
# Render: protected HTTPS Cloudflare Tunnel URL ending in /v1.
LLM_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5
ANTHROPIC_ANALYSIS_MODEL=claude-opus-5
ANTHROPIC_COPILOT_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8192
LLM_OPENAI_COMPATIBLE_BASE_URL=https://ai.bfab.io/v1
LLM_OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_CHAT_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_ANALYSIS_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_COPILOT_MODEL=gemma-2-2b-it
LLM_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=300
LLM_OPENAI_COMPATIBLE_MAX_TOKENS=8192
# Keep false on a shared/cloud deployment. Only a local operator should
# enable endpoint changes from the administration UI.
LLM_ALLOW_RUNTIME_OVERRIDE=false

# Authentication. Generate a fresh value, never commit it.
JWT_SECRET=CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION

# Local direct runs only. Docker Compose supplies its own db service URL.
DATABASE_URL=postgresql://psychapp:psychapp@localhost:5433/psychapp
DATABASE_SCHEMA=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=psychapp@localhost

APP_LOCALE=es-ES
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_MOCK_GOOGLE_LOGIN=false
SEED_DEMO_DATA=true
DEMO_PASSWORD=DemoPass123!
