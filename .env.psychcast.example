# Example only. Never commit real credentials or a populated .env file.
# Set production values in the psychcast Render service dashboard.
APP_ENV=production
DATABASE_URL=REPLACE_ME_WITH_PSYCHCAST_DATABASE_URL
DATABASE_SCHEMA=psychdeep_v12
FRONTEND_ORIGIN=https://psychcast.bfab.io
CORS_ORIGINS=https://psychcast.bfab.io
VITE_API_BASE_URL=REPLACE_ME_WITH_PSYCHCAST_API_URL

# Existing four-agent/provider routing — preserve provider selection and per-agent model IDs.
MODEL_DEPLOYMENT_ALIAS=local-tunnel
MODEL_POLICY_VERSION=support-policy-v1
MODEL_ALLOW_COMMERCIAL=true
LLM_DEFAULT_PROVIDER=anthropic
LLM_ALLOW_RUNTIME_OVERRIDE=true
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-4-6
ANTHROPIC_COPILOT_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna
OPENAI_COPILOT_MODEL=gpt-5.6-luna
OPENAI_MAX_TOKENS=8192
OPENAI_TIMEOUT_SECONDS=120
OPENAI_CHAT_EFFORT=medium
OPENAI_ANALYSIS_EFFORT=high
LLM_OPENAI_COMPATIBLE_BASE_URL=
LLM_OPENAI_COMPATIBLE_CHAT_MODEL=
LLM_OPENAI_COMPATIBLE_ANALYSIS_MODEL=
LLM_OPENAI_COMPATIBLE_COPILOT_MODEL=
LLM_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=45
LLM_OPENAI_COMPATIBLE_MAX_TOKENS=8192

# Local/managed inference: configure only after security and connectivity review.
MODEL_LOCAL_BASE_URL=
MODEL_LOCAL_CF_ACCESS_REQUIRED=true
MODEL_LOCAL_CF_ACCESS_HOST=ai.bfab.io
MODEL_LOCAL_CF_ACCESS_CLIENT_ID=
MODEL_LOCAL_CF_ACCESS_CLIENT_SECRET=
MODEL_LOCAL_CHAT_MODEL=
MODEL_LOCAL_ANALYSIS_MODEL=
MODEL_LOCAL_COPILOT_MODEL=
MODEL_LOCAL_TIMEOUT_SECONDS=120
MODEL_LOCAL_MAX_TOKENS=8192
MODEL_CLOUD_BASE_URL=
MODEL_CLOUD_API_KEY=
MODEL_CLOUD_CHAT_MODEL=
MODEL_CLOUD_ANALYSIS_MODEL=
MODEL_CLOUD_COPILOT_MODEL=
MODEL_CLOUD_TIMEOUT_SECONDS=180
MODEL_CLOUD_MAX_TOKENS=2048
LLM_USER_CREDENTIALS_KEY=
LLM_PERSONAL_MODE=

# Generate fresh secrets specifically for psychcast; never copy psychDeep's values.
JWT_SECRET=REPLACE_ME_GENERATE_UNIQUE_SECRET
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_NEVER_EXPOSE_TO_BROWSER
AUTH_SECRET=REPLACE_ME_GENERATE_UNIQUE_SECRET
ENCRYPTION_KEY=REPLACE_ME_GENERATE_UNIQUE_KEY

# Notifications: leave disabled/unset until configured securely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=psychcast@bfab.io
SEED_DEMO_DATA=false
RUNPOD_ENABLED=false

# Future layers remain disabled until implementation, validation and review.
MEMORY_LAYER_ENABLED=false
MODEL_PREDICTION_ENABLED=false
